# SmartCart configuration (copy to .env). The scaffold runs fully with the in-memory
# adapters and needs none of these; they wire the real managed-cloud infra later.
PORT=3000
NODE_ENV=development

# Data layer: "memory" (default, zero-dep) or "postgres"
STORE_DRIVER=memory
DATABASE_URL=postgres://smartcart:smartcart@localhost:5432/smartcart

# Cache / metering / leaderboards: "memory" (default) or "redis"
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379
# Redis L1-mirror coherence poll in ms (0 disables). Writes are always authoritative server-side;
# this controls how quickly a node sees OTHER nodes' writes.
CACHE_REFRESH_MS=1000

# Anti-scrape edge rate limit (requests per minute per device)
RATELIMIT_PER_MIN=120

# HTTP hardening: max request body (bytes; 8 MiB default fits a base64 receipt photo) + request timeout.
MAX_BODY_BYTES=8388608
REQUEST_TIMEOUT_MS=30000

# H3 resolution used as the geo shard/cache key (7-8 ≈ neighborhood)
H3_RESOLUTION=8

# Perception (receipt/shelf OCR + extraction): set an Anthropic key to run real VLM extraction
# (cheap Haiku tier, escalating to Opus only when low-confidence). Unset → deterministic stub.
# ANTHROPIC_API_KEY=sk-ant-...
# PERCEPTION_CHEAP_MODEL=claude-haiku-4-5-20251001
# PERCEPTION_EXPENSIVE_MODEL=claude-opus-4-8

# Product matching embeddings: set a Voyage AI key for real semantic embeddings; unset → a local
# deterministic feature-hashing embedder (zero-dep). Either way matching is cosine vector search.
# VOYAGE_API_KEY=pa-...
# EMBEDDING_MODEL=voyage-3

# Outbox relay sink: "console" (default), "webhook", or "kafka". If unset it is inferred —
# KAFKA_BROKERS present → kafka, else OUTBOX_WEBHOOK_URL present → webhook, else console.
# OUTBOX_SINK=console
#
# webhook sink: POST the durable event log batches to this collector/Pub-Sub push endpoint.
# OUTBOX_WEBHOOK_URL=http://localhost:4555
#
# kafka sink: comma-separated brokers + topic. The producer connects at startup (fail-fast).
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=smartcart.events

# Auth: HMAC secret for access JWTs (CHANGE in production) + token lifetimes.
AUTH_SECRET=dev-insecure-secret-change-me
ACCESS_TTL_SEC=900      # 15 min
REFRESH_TTL_SEC=1209600 # 14 days

# OIDC sign-in: set your OAuth client IDs to verify real Apple/Google id_tokens (RS256/ES256 against
# the providers' live JWKS). If unset, the dev "subject|email" verifier is used. Comma-separated.
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.smartcart.app

