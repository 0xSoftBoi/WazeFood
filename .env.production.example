# Production environment for the WazeFood API. Copy to .env.production and fill in.
#   cp .env.production.example .env.production
# docker-compose.prod.yml sets DATABASE_URL / REDIS_URL / drivers itself; everything below is the
# config + secrets you provide.

# --- Required ---
# Sign the access JWTs. MUST be a strong random value (NOT the dev default). Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48

# Postgres password used by the compose stack (api + postgres must match). Generate + keep secret.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# CORS allow-origin for the web build of the app. Use a concrete origin in production
# (e.g. https://app.wazefood.com), not "*".
CORS_ORIGIN=*

# --- Recommended ---
# Token lifetimes (seconds). Defaults: 15 min access, 14 day refresh.
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=1209600
# Edge rate limit (requests/min/device) and request body cap (bytes; fits a base64 receipt photo).
RATELIMIT_PER_MIN=120
MAX_BODY_BYTES=8388608

# --- Optional features (leave unset to keep them off; the app degrades gracefully) ---
# Social sign-in: accept these provider audiences (must match the app's EXPO_PUBLIC_* client IDs).
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.smartcart.app
# Real receipt OCR/extraction (Claude VLM). Unset → deterministic stub.
# ANTHROPIC_API_KEY=sk-ant-...
# Real product-matching embeddings (Voyage). Unset → local hashing embedder.
# VOYAGE_API_KEY=pa-...
# Outbox sink: console (default) | webhook | kafka.
# OUTBOX_SINK=kafka
# KAFKA_BROKERS=broker1:9092,broker2:9092
# KAFKA_TOPIC=wazefood.events
