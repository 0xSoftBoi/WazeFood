{
  "expo": {
    "name": "SmartCart",
    "slug": "smartcart",
    "version": "0.1.0",
    "scheme": "smartcart",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06A36A",
      "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#000000" }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartcart.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SmartCart uses the camera to scan grocery barcodes and capture receipts.",
        "NSPhotoLibraryUsageDescription": "SmartCart lets you attach a receipt or shelf-tag photo to a price report.",
        "NSLocationWhenInUseUsageDescription": "SmartCart uses your location to find the best grocery prices at stores near you."
      }
    },
    "android": {
      "package": "com.smartcart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06A36A"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
